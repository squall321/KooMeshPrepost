{
  "app.name": "KooMeshPrepost",
  "app.version": "1.0.0",
  "app.author": "KooMesh Development Team",
  "ui.window.title": "KooMesh Preprocessor",
  "ui.window.width": 1280,
  "ui.window.height": 720,
  "ui.window.maximized": false,
  "ui.theme": "dark",
  "ui.font_size": 12,
  "ui.show_toolbar": true,
  "ui.show_statusbar": true,
  "ui.recent_files": ["mesh1.k", "mesh2.k", "mesh3.k"],
  "renderer.fov": 45.0,
  "renderer.near_plane": 0.1,
  "renderer.far_plane": 1000.0,
  "renderer.line_width": 1.0,
  "renderer.point_size": 3.0,
  "renderer.antialiasing": true,
  "renderer.background.r": 0.2,
  "renderer.background.g": 0.3,
  "renderer.background.b": 0.4,
  "selection.highlight_color.r": 1.0,
  "selection.highlight_color.g": 0.5,
  "selection.highlight_color.b": 0.0,
  "performance.max_threads": 8,
  "performance.chunk_size": 10000,
  "performance.use_gpu": true,
  "debug.enabled": false,
  "debug.show_fps": true,
  "debug.show_memory": false,
  "debug.log_level": "INFO"
}
